{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pibras.ibvi.ai/schema/release-policy.schema.json",
  "title": "PIBRAS Release Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "phase",
    "identity",
    "approvals"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "phase": {
      "enum": [
        "identity",
        "rfc_accepted",
        "legal_approved",
        "rc",
        "final"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutral_org",
        "canonical_host",
        "repo_url",
        "brand_exempt_paths"
      ],
      "properties": {
        "neutral_org": {
          "const": "pibras"
        },
        "canonical_host": {
          "const": "pibras.ibvi.ai"
        },
        "repo_url": {
          "const": "https://github.com/pibras/pibras.git"
        },
        "brand_exempt_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "approver",
          "date"
        ],
        "properties": {
          "gate": {
            "enum": [
              "identity",
              "rfc",
              "legal",
              "rc",
              "final"
            ]
          },
          "approver": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "type": "string"
          },
          "review_reference": {
            "type": "string",
            "minLength": 1,
            "description": "Referência imutável de revisão (URL de PR, commit ou ata)."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "approvals": {
          "contains": {
            "type": "object",
            "properties": {
              "gate": {
                "const": "identity"
              }
            },
            "required": [
              "gate"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "rfc_accepted",
              "legal_approved",
              "rc",
              "final"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approvals": {
            "description": "Pelo menos duas aprovações no gate 'rfc'.",
            "minContains": 2,
            "contains": {
              "type": "object",
              "required": [
                "gate",
                "approver",
                "date",
                "review_reference"
              ],
              "properties": {
                "gate": {
                  "const": "rfc"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "legal_approved"
          }
        }
      },
      "then": {
        "properties": {
          "approvals": {
            "contains": {
              "type": "object",
              "properties": {
                "gate": {
                  "const": "legal"
                }
              },
              "required": [
                "gate"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "rc"
          }
        }
      },
      "then": {
        "properties": {
          "approvals": {
            "contains": {
              "type": "object",
              "properties": {
                "gate": {
                  "const": "rc"
                }
              },
              "required": [
                "gate"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "final"
          }
        }
      },
      "then": {
        "properties": {
          "approvals": {
            "contains": {
              "type": "object",
              "properties": {
                "gate": {
                  "const": "final"
                }
              },
              "required": [
                "gate"
              ]
            }
          }
        }
      }
    }
  ]
}
