{
  "name": "pibras-standard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:types": "node --experimental-strip-types --test tests/types/*.test.ts",
    "export:types-manifest": "node --experimental-strip-types scripts/export_types_manifest.ts",
    "cli": "node --experimental-strip-types src/cli/pibras-cli.ts",
    "serve": "node --experimental-strip-types src/api/server.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
